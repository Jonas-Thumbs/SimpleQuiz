# Generated with Gemini to fix problems with inconsistent CLRF and LF line endings.
# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Force specific text files to LF
*.py text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.json text eol=lf

# Keep binary files untouched
*.png binary
*.jpg binary
*.ico binary